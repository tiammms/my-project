# Copy to .env and adjust. No secrets are required for the local demo.
NS_ENV=development
NS_DB_PATH=backend/data/neuroshield.db
NS_MODEL_PATH=ml/artifacts/model.joblib
NS_POLICY_PATH=ml/artifacts/policy.json
NS_DEMO_DATA_PATH=ml/artifacts/demo_transactions.csv.gz
NS_RESULTS_DIR=experiments/results
NS_FRONTEND_DIST=frontend/dist
# Explicit CORS allow-list (comma separated). Add the dashboard origin here.
NS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NS_MAX_BODY_BYTES=262144
NS_BATCH_LIMIT=100
NS_RATE_LIMIT_PER_MINUTE=600
# If set, PUT /api/v1/settings requires header X-Admin-Token. Never commit a real value.
NS_ADMIN_TOKEN=
NS_LOG_LEVEL=INFO
